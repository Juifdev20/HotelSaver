{
  "expo": {
    "name": "HotelSaver",
    "slug": "hotelsaver",
    "scheme": "hotelsaver",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#053483",
    "ios": {
      "bundleIdentifier": "com.hotelsaver.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.hotelsaver.app",
      "adaptiveIcon": {
        "backgroundColor": "#053483",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSurfaceTranslucide",
      "./plugins/withSignatureRelease",
      "./plugins/withCxxCourt",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#053483"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HotelSaver accède à vos photos pour illustrer vos chambres et le site de votre hôtel."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HotelSaver utilise la caméra pour scanner le code-barres des articles à la caisse.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#053483"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#053483"
        }
      ]
    ]
  }
}
