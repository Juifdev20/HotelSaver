# apps/mobile/.env.example - copier en .env (jamais commite).
# Adresse de l'API integree au build : l'utilisateur n'a aucun champ pour la modifier.
# Vide = serveur local de developpement (http://localhost:3001, via adb reverse).
# Build de production, par exemple : EXPO_PUBLIC_API_URL=https://api.hotelsaver.com
EXPO_PUBLIC_API_URL=
