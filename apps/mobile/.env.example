# apps/mobile/.env.example - copier en .env (jamais commite).
# Adresse de l'API integree au build : l'utilisateur n'a aucun champ pour la modifier.
# Vide = serveur local de developpement (http://localhost:3001, via adb reverse).
# Build de production, par exemple : EXPO_PUBLIC_API_URL=https://api.hotelsaver.com
EXPO_PUBLIC_API_URL=

# Site HotelSaver (https), pour le bouton « Payer sur le site » quand le serveur ne donne pas l adresse. Exemple : EXPO_PUBLIC_SITE_URL=https://hotelsaver.com
EXPO_PUBLIC_SITE_URL=

# Projet Supabase integre au build. Vide = « Hotelsaver Test » (developpement).
# Build publie : URL et cle anon du projet « Hotelsaver Prod » (Dashboard -> Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
