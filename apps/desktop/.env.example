# apps/desktop/.env.example - copier en .env (jamais commite).
# Adresse de l'API integree au build : l'utilisateur n'a aucun champ pour la modifier.
# Vide = serveur local de developpement (http://localhost:3001).
# Build de production, par exemple : MAIN_VITE_API_URL=https://api.hotelsaver.com
MAIN_VITE_API_URL=
# Projet Supabase integre au build. Vide = « Hotelsaver Test » (developpement).
# Build publie : URL et cle anon du projet « Hotelsaver Prod » (Dashboard -> Project Settings -> API).
MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
