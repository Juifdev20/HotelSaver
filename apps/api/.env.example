# apps/api/.env.example — copier en .env et renseigner les vraies valeurs
# du projet Supabase de production (jamais commiter le .env réel).

# Utiliser le pooler Supabase en mode SESSION (port 5432, pas 6543) :
# Dashboard > Project Settings > Database > "Connection pooling". La connexion
# directe (db.<ref>.supabase.co) est IPv6-only sur les projets récents et peut
# être injoignable depuis un réseau sans route IPv6 — voir DECISIONS.md.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres
# SUPABASE_URL sert aussi à vérifier les jetons de connexion : SupabaseAuthGuard
# récupère les clés publiques sur ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (signature ES256). Aucun secret JWT partagé n'est nécessaire — voir DECISIONS.md.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
NODE_ENV=development
# Origines autorisées, séparées par des virgules : le site public, et en
# développement le serveur Vite de l'app Electron (port 5173 par défaut).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Adresse du site web (apps/web) : le lien de l'e-mail « mot de passe oublié » y
# ramène l'utilisateur (page /reinitialiser-mot-de-passe). Cette adresse doit aussi
# figurer dans Supabase > Authentication > URL Configuration > Redirect URLs.
SITE_WEB_URL=http://localhost:5175

# Domaines personnalisés des hôtels (Phase 13, onboarding manuel par le
# Super-Admin — voir DECISIONS.md) : nécessaires uniquement après le
# déploiement réel de apps/web sur Render. RENDER_WEB_SERVICE_ID est l'id du
# Web Service Render qui héberge apps/web (ex. srv-xxxxx, visible dans
# l'URL du dashboard Render de ce service).
RENDER_API_KEY=
RENDER_WEB_SERVICE_ID=
