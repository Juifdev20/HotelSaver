# apps/api/.env.example — copier en .env et renseigner les vraies valeurs
# du projet Supabase de production (jamais commiter le .env réel).

DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret JWT du projet Supabase (Dashboard > Project Settings > API > JWT Secret).
# Utilisé par SupabaseAuthGuard pour vérifier la signature des jetons émis par
# Supabase Auth (HS256). Voir DECISIONS.md si le projet utilise les nouvelles
# clés de signature asymétriques (JWKS) au lieu du secret JWT partagé.
JWT_SECRET=

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
