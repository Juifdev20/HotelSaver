# apps/super-admin/.env.example — copier en .env et renseigner les vraies
# valeurs (jamais commiter le .env réel). Config par variables d'environnement
# Vite (VITE_*) plutôt que des valeurs par défaut codées en dur : cette app
# est destinée à un vrai déploiement, pas seulement du développement local.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
