# apps/web/.env.example — copier en .env. inscrireHotel ne parle qu'à notre
# API, jamais directement à Supabase Auth (pas de connexion sur ce site,
# voir DECISIONS.md Phase 8) — pas de VITE_SUPABASE_* ici.
VITE_API_URL=http://localhost:3001

# Liens de téléchargement de l'application, affichés sur la page d'accueil et
# après l'inscription. Collez ici l'URL de la fiche sur chaque store ; tant qu'une
# variable est vide, son bouton affiche « bientôt disponible ».
#   Play Store : https://play.google.com/store/apps/details?id=<identifiant>
#   App Store  : https://apps.apple.com/app/id<numéro>
VITE_URL_PLAY_STORE=
VITE_URL_APP_STORE=
VITE_URL_WINDOWS=
