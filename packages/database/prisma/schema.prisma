// Schéma Prisma — Hôtel Chicago
// Transcrit depuis la section 7 de hotel-chicago-prompt-claude-code.md.
// Voir DECISIONS.md pour les ajustements mécaniques nécessaires à la
// compilation du schéma (relations inverses manquantes dans le prompt
// d'origine, index explicites sur les clés étrangères).

// Prisma 7 : client TypeScript généré dans src/ (compilé par tsc avec le
// reste du paquet, en CommonJS comme apps/api). L'URL de connexion vit dans
// prisma.config.ts (plus de `url = env(...)` ici). Voir DECISIONS.md,
// « Migration Prisma 5 → 7 » pour le pourquoi (lenteur via le pooler).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECEPTIONNISTE
  CAFETARIA
  PATRON
}

enum StatutChambre {
  LIBRE
  OCCUPEE
  RESERVEE
  NETTOYAGE
}

enum StatutCompte {
  OUVERT
  FERME
}

enum ModePaiement {
  CASH
  MOBILE_MONEY
  FACTURE_CHAMBRE
}

enum Devise {
  USD
  CDF
}

enum StatutLicence {
  ESSAI
  ACTIF
  SUSPENDU
  RESILIE
}

/// Département auquel appartient un rapport mensuel PDF.
enum DepartementRapport {
  CAFETERIA
  RECEPTION
}

/// ACTIF = révision courante ; REMPLACE = ancienne révision conservée pour
/// la traçabilité (on n'écrase jamais un rapport déjà remis au patron).
enum StatutRapport {
  ACTIF
  REMPLACE
}

/// Un hôtel client de la plateforme HotelSaver. Hôtel Chicago est le premier
/// (tenant #1), migré avec statutLicence = ACTIF — voir migration
/// 20260927120000_multi_tenant_foundations. `statutLicence` évolue dans le
/// temps via `PaiementLicence` (Phase 12, suivi manuel des paiements) : la
/// date de validité n'est jamais stockée ici, toujours calculée depuis le
/// dernier paiement (voir apps/api/src/super-admin/calculer-validite.ts).
model Hotel {
  id               String        @id @default(uuid())
  nom              String
  sousDomaine      String        @unique
  statutLicence    StatutLicence @default(ESSAI)
  // Séparation des tâches : false (défaut) = le patron ne réalise PAS les opérations du quotidien
  // (réserver, check-in/out, facturer, ouvrir/encaisser un compte cafétaria) ; il peut l'activer s'il travaille seul.
  patronPeutOperer Boolean @default(false)
  emailContact     String?
  telephoneContact String?
  adresse          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Domaine personnalisé (Phase 13, onboarding manuel par le Super-Admin
  // uniquement — voir DECISIONS.md) : attaché via l'API Render Custom
  // Domains (apps/api/src/super-admin/render-domains.service.ts).
  // `domainePersonnaliseId` est l'id renvoyé par Render, nécessaire pour le
  // supprimer/consulter ensuite ; jamais renseigné sans que l'appel Render
  // ait déjà réussi (pas d'état "en base mais pas chez Render").
  // `domaineVerifie` reflète le dernier `verificationStatus` connu — Render
  // vérifie lui-même la propagation DNS en arrière-plan, ce champ est
  // rafraîchi à la demande (bouton "Vérifier"), jamais par un cron
  // automatique dans cette phase.
  domainePersonnalise   String?   @unique
  domainePersonnaliseId String?
  domaineVerifie        Boolean   @default(false)
  domaineAjouteLe       DateTime?

  branding         HotelBranding?
  site             HotelSite?
  notifications    Notification[]
  appareilsPush    AppareilPush[]

  utilisateurs     Utilisateur[]
  chambres         Chambre[]
  clients          Client[]
  reservations     Reservation[]
  factures         Facture[]
  produits         Produit[]
  tauxChanges      TauxChange[]
  mouvementsStock  MouvementStock[]
  comptesCafeteria CompteCafeteria[]
  sousComptes      SousCompte[]
  lignesCommande   LigneCommande[]
  ventesCafeteria  VenteCafeteria[]
  paiementsLicence PaiementLicence[]
  rapportsMensuels RapportMensuel[]
}

/// Charte graphique d'un hôtel. Un seul JSON pour toute la palette
/// (claire + sombre) plutôt que des dizaines de colonnes scalaires : elle
/// n'est jamais interrogée colonne par colonne en SQL, seulement lue en bloc
/// par le frontend (packages/ui / apps/mobile). Les 3 polices restent des
/// colonnes scalaires : simples, stables, jamais interrogées comme données
/// structurées.
model HotelBranding {
  id              String   @id @default(uuid())
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId         String   @unique
  logoUrl         String?
  policeAffichage String   @default("Fraunces")
  policeCorps     String   @default("Public Sans")
  policeMono      String   @default("IBM Plex Mono")
  palette         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Contenu du site public de l'hôtel (sous-domaine), défini par le PATRON
/// depuis son compte. Séparé de `HotelBranding` (charte graphique) : ici le
/// contenu éditorial. Les coordonnées (nom, adresse, téléphone, e-mail) restent
/// sur `Hotel`. `services` = [{ icone, titre, description }], `reseaux` =
/// { facebook?, instagram?, tiktok?, youtube?, x? } — JSON, jamais filtrés en SQL.
model HotelSite {
  id             String   @id @default(uuid())
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId        String   @unique
  slogan         String?
  presentation   String?
  couvertureUrl  String?
  galerie        String[]
  services       Json     @default("[]")
  whatsapp       String?
  horaireArrivee String?
  horaireDepart  String?
  reception24h   Boolean  @default(false)
  lienCarte      String?
  reseaux        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Notification métier (réservation reçue, stock bas…), propre à UN hôtel et destinée à
/// certains rôles seulement : `roles` fixe qui la voit. `cleDedup` évite d'émettre deux fois
/// la même alerte (ex. départ dépassé d'une réservation) ; plusieurs lignes sans clé sont permises.
model Notification {
  id        String            @id @default(uuid())
  hotel     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId   String
  type      String
  titre     String
  corps     String
  roles     Role[]
  /// { ecran: "reservations" | "stock" | …, id?: string } — où ouvrir l'app au clic.
  lien      Json              @default("{}")
  cleDedup  String?
  createdAt DateTime          @default(now())
  lectures  NotificationLue[]

  @@unique([hotelId, cleDedup])
  @@index([hotelId, createdAt])
}

/// État « lu » PAR UTILISATEUR (un compte de rôle peut être ouvert sur plusieurs appareils).
model NotificationLue {
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notificationId String
  utilisateurId  String
  luLe           DateTime     @default(now())

  @@id([notificationId, utilisateurId])
}

/// Téléphone qui reçoit les notifications push (jeton FCM). Rattaché à l'utilisateur CONNECTÉ :
/// retiré à la déconnexion, sinon l'alerte du patron s'afficherait chez un employé.
model AppareilPush {
  id            String      @id @default(uuid())
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId       String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  utilisateurId String
  plateforme    String
  jeton         String      @unique
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  derniereVueLe DateTime    @default(now())

  @@index([hotelId])
  @@index([utilisateurId])
}

/// Administrateur de la plateforme HotelSaver, indépendant de tout hôtel —
/// volontairement séparé d'`Utilisateur` plutôt qu'un `Role.SUPER_ADMIN`
/// (voir DECISIONS.md, Phase 3) : chaque service filtre désormais
/// strictement par `hotelId` (Phase 2), et `Utilisateur.hotelId` est une FK
/// obligatoire — un rôle "sans hôtel" dans ce même modèle forcerait un cas
/// `hotelId` nullable dans tout le code qu'on vient de durcir. Un même
/// membre de l'équipe peut avoir un compte ici ET un compte `Utilisateur`
/// séparé pour un hôtel test, sans lien entre les deux. Pas de champ `role` :
/// un seul niveau de super-admin pour l'instant.
model SuperAdmin {
  id             String   @id @default(uuid())
  nom            String
  actif          Boolean  @default(true)
  supabaseAuthId String   @unique
  createdAt      DateTime @default(now())

  paiementsEnregistres PaiementLicence[]
}

enum MethodePaiementLicence {
  VIREMENT
  MOBILE_MONEY
  ESPECES
  AUTRE
}

/// Journal des paiements d'abonnement (Phase 12, suivi manuel — pas
/// d'intégration de paiement en ligne pour l'instant, décision du patron).
/// Chaque ligne est immuable : jamais de mise à jour, jamais de suppression.
/// La date de validité d'un hôtel n'est jamais stockée nulle part — toujours
/// calculée à partir du dernier paiement (voir calculer-validite.ts) : une
/// seule source de vérité, aucune désynchronisation possible.
model PaiementLicence {
  id                     String                 @id @default(uuid())
  hotel                  Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId                String
  montant                Decimal
  devise                 Devise
  methode                MethodePaiementLicence
  periodeCouverteJusquau DateTime
  note                   String?
  enregistrePar          SuperAdmin             @relation(fields: [enregistreParSuperAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enregistreParSuperAdminId String
  createdAt              DateTime               @default(now())

  @@index([hotelId])
}

model Utilisateur {
  id             String   @id @default(uuid())
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId        String
  nom            String
  role           Role
  actif          Boolean  @default(true)
  supabaseAuthId String   @unique
  createdAt      DateTime @default(now())
  /// Dénormalisé depuis Supabase Auth (source de vérité pour l'authentification
  /// elle-même) — évite un appel à l'API Admin Supabase par ligne pour afficher
  /// l'écran "Utilisateurs" (Phase 15). Nullable : les comptes créés avant
  /// cette Phase (via creer-utilisateur.js, sans ce champ) n'ont pas de valeur
  /// tant qu'ils ne sont pas mis à jour manuellement.
  email          String?  @unique
  appareilsPush  AppareilPush[]

  @@index([hotelId])
}

model Chambre {
  id           String         @id @default(uuid())
  hotel        Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId      String
  numero       String         @unique
  type         String
  prixParNuit  Decimal
  devise       Devise // USD ou CDF, propre à chaque chambre
  statut       StatutChambre  @default(LIBRE)
  photos       String[] // URLs Supabase Storage (bucket chambres-photos), ajoutées depuis l'app — voir section 5.1
  reservations Reservation[]
  updatedAt    DateTime       @updatedAt
  syncVersion  Int            @default(1)

  @@index([statut])
  @@index([hotelId])
}

model Client {
  id           String        @id @default(uuid())
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId      String
  nom          String
  telephone    String?
  email        String?
  createdAt    DateTime      @default(now())
  // Ajoutés en Phase 16 pour rendre Client pullable par /sync/pull (le pull
  // incrémental filtre sur updatedAt > curseur, comme toutes les entités
  // synchronisées — voir section 10.3 et DECISIONS.md) :
  updatedAt    DateTime      @updatedAt
  syncVersion  Int           @default(1)
  reservations Reservation[]

  @@index([hotelId])
}

model Reservation {
  id          String   @id @default(uuid())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId     String
  chambre     Chambre  @relation(fields: [chambreId], references: [id])
  chambreId   String
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  dateArrivee DateTime
  dateDepart  DateTime
  acompte     Decimal  @default(0)
  statut      String // EN_ATTENTE, CONFIRMEE, EN_COURS, TERMINEE, ANNULEE
  origine     String // RECEPTION, SITE_PUBLIC
  createdBy   String // Utilisateur.id
  // Ajoutés en Phase 2 (absents du schéma section 7, mais requis par la section 8/17 :
  // "aucune suppression physique ... uniquement des annulations tracées avec motif") :
  annuleLe        DateTime?
  motifAnnulation String?
  facture     Facture?
  updatedAt   DateTime @updatedAt
  syncVersion Int      @default(1)

  @@index([chambreId])
  @@index([clientId])
  @@index([dateArrivee, dateDepart])
  @@index([hotelId])
}

model Facture {
  id            String      @id @default(uuid())
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId       String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  reservationId String      @unique
  // Montant du séjour lui-même, dans la devise propre à la chambre (Chambre.devise) :
  montantChambre Decimal
  deviseChambre  Devise
  // Totaux incluant les ventes cafétaria liées à ce séjour (VenteCafeteria.reservationLieeId),
  // jamais convertis ni fusionnés entre devises (voir section 9.4) :
  montantTotalUSD Decimal @default(0)
  montantTotalCDF Decimal @default(0)
  modePaiement    ModePaiement
  // Ce que le client a réellement remis, si différent de la devise due (paiement croisé) :
  deviseRegleeParClient Devise?
  montantRegleParClient Decimal?
  tauxChangeApplique    Decimal? // copie du taux du jour utilisé pour le paiement croisé, jamais recalculé après coup
  // Ajoutés en Phase 2 : la devise dans laquelle le caissier a choisi de rendre la
  // monnaie n'est pas dérivable des autres champs (c'est un choix indépendant, voir
  // section 9.4) — sans ces deux colonnes, cette information serait perdue après la
  // transaction et impossible à réimprimer correctement (gabarit section 11.2).
  deviseMonnaieRendue   Devise?
  montantMonnaieRendue  Decimal?
  numeroRecu            String
  imprimeLe             DateTime?
  annuleLe              DateTime?
  motifAnnulation       String?
  createdAt             DateTime  @default(now())
  updatedAt              DateTime @updatedAt
  syncVersion            Int      @default(1)

  @@unique([hotelId, numeroRecu])
  @@index([hotelId])
}

model Produit {
  id              String           @id @default(uuid())
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId         String
  nom             String
  categorie       String
  prix            Decimal
  devise          Devise // USD ou CDF, propre à chaque produit
  photo           String? // URL Supabase Storage (bucket menu-photos), ajoutée depuis l'app — voir section 5.1
  stockActuel     Decimal          @default(0)
  seuilAlerte     Decimal          @default(5)
  actif           Boolean          @default(true)
  mouvementsStock MouvementStock[]
  lignesCommande  LigneCommande[]
  updatedAt       DateTime         @updatedAt
  syncVersion     Int              @default(1)

  @@index([hotelId])
}

// Taux de change de référence, saisi manuellement par le PATRON, utilisé UNIQUEMENT
// à titre informatif (dashboard, paiement croisé) — jamais pour fusionner deux totaux
// légaux de devises différentes en un seul montant comptable.
model TauxChange {
  id         String   @id @default(uuid())
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId    String
  cdfParUsd  Decimal // ex: 2800 (1 USD = 2800 CDF)
  definiPar  String // Utilisateur.id (PATRON)
  createdAt  DateTime @default(now())

  @@index([hotelId])
}

model MouvementStock {
  id          String   @id @default(uuid())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId     String
  produit     Produit  @relation(fields: [produitId], references: [id])
  produitId   String
  quantite    Decimal
  type        String // ENTREE, SORTIE_VENTE, PERTE, AJUSTEMENT
  motif       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncVersion Int      @default(1)

  @@index([produitId])
  @@index([hotelId])
}

model CompteCafeteria {
  id          String        @id @default(uuid())
  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId     String
  tableOuNom  String
  statut      StatutCompte  @default(OUVERT)
  ouvertPar   String // Utilisateur.id
  ouvertLe    DateTime      @default(now())
  fermeLe     DateTime?
  sousComptes SousCompte[]
  ventes      VenteCafeteria[]
  updatedAt   DateTime      @updatedAt
  syncVersion Int           @default(1)

  @@index([statut])
  @@index([hotelId])
}

model SousCompte {
  id          String          @id @default(uuid())
  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId     String
  compte      CompteCafeteria @relation(fields: [compteId], references: [id])
  compteId    String
  nom         String // "Personne 1", ou un nom donné par le serveur
  // Renseigné quand cette personne a réglé SA part (encaissement par personne) : ses lignes sont
  // alors verrouillées, le compte reste ouvert pour les autres et se ferme au dernier règlement.
  payeLe      DateTime?
  lignes      LigneCommande[]
  updatedAt   DateTime        @updatedAt
  syncVersion Int             @default(1)

  @@index([compteId])
  @@index([hotelId])
}

model LigneCommande {
  id           String     @id @default(uuid())
  hotel        Hotel      @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId      String
  sousCompte   SousCompte @relation(fields: [sousCompteId], references: [id])
  sousCompteId String
  produit      Produit    @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Decimal
  // Copie du prix ET de la devise du produit au moment de la commande (jamais recalculés
  // si le prix ou la devise du produit change ensuite) :
  prixUnitaire Decimal
  devise       Devise
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  syncVersion  Int        @default(1)

  @@index([sousCompteId])
  @@index([produitId])
  @@index([hotelId])
}

model VenteCafeteria {
  id      String          @id @default(uuid())
  hotel   Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId String
  compte  CompteCafeteria @relation(fields: [compteId], references: [id])
  compteId String
  // Un même compte peut mélanger des articles en USD et en CDF : deux totaux séparés,
  // jamais additionnés entre eux (voir section 9.4) :
  montantTotalUSD       Decimal      @default(0)
  montantTotalCDF       Decimal      @default(0)
  modePaiement          ModePaiement
  deviseRegleeParClient Devise?
  montantRegleParClient Decimal?
  tauxChangeApplique    Decimal?
  // Ajoutés en Phase 3, symétriques aux mêmes champs sur Facture (Phase 2) —
  // voir DECISIONS.md, même raisonnement (le choix de devise du rendu de
  // monnaie n'est pas dérivable des autres champs) :
  deviseMonnaieRendue   Devise?
  montantMonnaieRendue  Decimal?
  reservationLieeId     String? // si facturé sur le séjour d'une chambre (Reservation.id)
  // Renseigné pour un encaissement « une personne » (reçu individuel), vide pour un règlement groupé.
  sousCompteId          String?
  numeroRecu            String
  imprimeLe             DateTime?
  annuleLe              DateTime?
  motifAnnulation       String?
  createdBy             String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  syncVersion           Int          @default(1)

  @@unique([hotelId, numeroRecu])
  @@index([compteId])
  @@index([hotelId])
}

/// Rapport mensuel PDF officiel remis au patron par chaque département
/// (cafétaria, réception). Une ligne = une révision : « régénérer » crée
/// une nouvelle version (version+1) et marque l'ancienne REMPLACE — le
/// fichier et les chiffres figés dans `chiffres` restent consultables,
/// jamais écrasés (traçabilité d'un document comptable remis).
model RapportMensuel {
  id           String             @id @default(uuid())
  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId      String
  departement  DepartementRapport
  /// Période « AAAA-MM » en fuseau Africa/Lubumbashi (ex. « 2026-09 »).
  periode      String
  /// Révision : 1 pour la première génération du mois, +1 à chaque « Régénérer ».
  version      Int                @default(1)
  /// Numéro officiel unique dans l'hôtel : RAP-CAF-202609-001.
  numero       String
  /// true = généré avant la fin du mois (filigrane « PROVISOIRE » dans le PDF).
  provisoire   Boolean            @default(false)
  statut       StatutRapport      @default(ACTIF)
  /// Chemin du PDF dans le bucket privé `rapports` : {hotelId}/{periode}/{numero}.pdf.
  fichier      String
  /// Instantanés de l'auteur — lisibles même si le compte est renommé plus tard.
  genereParId  String
  genereParNom String
  genereLe     DateTime           @default(now())
  /// Instantané JSON des totaux et du contrôle de concordance (comparé au
  /// tableau de bord calculé par la même fonction d'agrégation).
  chiffres     Json
  /// true si les totaux du rapport concordent avec le tableau de bord du mois.
  concordant   Boolean            @default(true)
  /// SHA-256 abrégé (16 car.) des chiffres — pied de page « intégrité » du document.
  empreinte    String

  @@unique([hotelId, departement, periode, version])
  @@unique([hotelId, numero])
  @@index([hotelId, periode])
}
