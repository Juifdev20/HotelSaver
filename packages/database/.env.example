# Deux projets Supabase (17/10/2026, voir DECISIONS.md) : « Hotelsaver Test » pour le
# développement, « Hotelsaver Prod » pour la version publiée. Copier ce fichier en
#   .env.test  (valeurs du projet Test — utilisé par défaut)
#   .env.prod  (valeurs du projet Prod — scripts lancés avec --prod --oui-prod)
# Jamais commités. Les scripts (migrate:appliquer, creer-super-admin…) les lisent via
# scripts/cible.js.
#
# DATABASE_URL : Dashboard → Connect → « Transaction pooler » (port 6543), SANS
# ?pgbouncer=true. La connexion directe db.<ref>.supabase.co est IPv6 uniquement.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Dashboard → Project Settings → API.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
