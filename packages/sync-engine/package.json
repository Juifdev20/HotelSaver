  },
  "dependencies": {
    "@hotel-chicago/api-client": "workspace:*",
    "@hotel-chicago/types": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
