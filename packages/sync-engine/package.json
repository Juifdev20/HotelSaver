{
  "name": "@hotel-chicago/sync-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Moteur de synchronisation hors ligne (mobile + desktop) — voir README.md",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/finaliser-build.cjs",
