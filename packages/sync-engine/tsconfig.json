{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022", "DOM"],
    // ESM, même raisonnement que packages/api-client : consommé par
    // apps/mobile (Metro) qui importe déjà @hotel-chicago/api-client avec
    // succès sous cette même configuration.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
