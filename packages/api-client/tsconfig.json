{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022", "DOM"],
    // ESM : seul consommateur actuel = apps/desktop (renderer bundlé par
    // Vite). Voir packages/ui/tsconfig.json pour l'explication complète du
    // problème d'interop CJS→ESM que ceci évite. Pas de double build CJS/ESM
    // ici (contrairement à packages/types) car aucun consommateur Node/CJS
    // n'existe pour ce paquet à ce jour.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
