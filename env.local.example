# env.local — fichier UNIQUE à remplir après une réinstallation.
# Copier ce fichier en env.local (jamais commité), remplir les valeurs,
# puis lancer : node scripts/distribuer-env.mjs
# Il crée automatiquement tous les .env individuels du monorepo.
#
# Où trouver chaque valeur :
#   Supabase → projet Test ou Prod → Project Settings → API
#   DATABASE_URL → Connect → Transaction pooler (port 6543, sans ?pgbouncer=true)

# ── Projet Supabase « Hotelsaver Test » (développement local) ────────────────
TEST_DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
TEST_SUPABASE_URL=https://<ref>.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# ── Projet Supabase « Hotelsaver Prod » (scripts de migration uniquement) ────
PROD_DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
PROD_SUPABASE_URL=https://<ref>.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=

# ── Variables optionnelles (laisser vide = fonctionnel en local) ─────────────
# Render (domaines personnalisés des hôtels) :
RENDER_API_KEY=
RENDER_WEB_SERVICE_ID=
# Cloudflare Turnstile (CAPTCHA) :
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
# ScanLinkPay (paiement Mobile Money) :
LINKPAY_API_URL=
LINKPAY_NUMERO_MARCHAND=
LINKPAY_SITE_URL=
# Liens de téléchargement affichés sur le site public :
VITE_URL_PLAY_STORE=
VITE_URL_APP_STORE=
VITE_URL_WINDOWS=
VITE_URL_ANDROID_APK=
VITE_URL_SCANLINKPAY=
